# Karma — Goals & Habits Tracker

# Auth (JWT) — must match JWT_SECRET in every other module's .env
JWT_SECRET=your-generated-jwt-secret-here

# Telegram bot for habit check-in notifications (optional — leave blank to disable)
# Create a bot via @BotFather, then message it once and check
# https://api.telegram.org/bot<token>/getUpdates for your chat ID.
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id
