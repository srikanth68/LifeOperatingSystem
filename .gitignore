# ── Maaya OS ──

# .NET build artifacts
**/bin/
**/obj/
**/.vs/
*.user

# SQLite databases (recreated on startup)
*.db
*.db-shm
*.db-wal

# Secrets (each module has a .env.template checked in instead)
.env

# Per-machine Claude Code settings (permissions differ per machine)
.claude/settings.local.json

# Document storage (user uploads, not source)
**/storage/

# Backup snapshots and the status file the nightly job writes. These are copies of
# every database in the system — financial, health, property — and must never reach
# a remote. The script and its launchd job under deploy/backup/ ARE tracked.
deploy/backups/
deploy/data/backup-status.json

# Node / frontend
**/node_modules/
**/dist/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo

# FUSE filesystem leftovers (deleted-but-open file copies, not source)
.fuse_hidden*

# ── Xcode (ios/) ──
# Per-user state — window layout, breakpoints, last-opened file, the sidebar
# scroll position. Rewritten every time the project is opened, so tracking it
# means a dirty tree after merely looking at the app. The SHARED scheme lives in
# xcshareddata/ and is deliberately NOT ignored: without it a fresh clone opens
# with no run target.
**/xcuserdata/
ios/**/DerivedData/
ios/**/build/
*.xcuserstate
*.moved-aside
*.hmap

# Xcode build products / debug symbols
*.ipa
*.dSYM
*.dSYM.zip

# Swift Package Manager per-checkout state (Package.resolved IS tracked)
.swiftpm/xcode/package.xcworkspace/xcuserdata/
ios/**/.build/

# Third-party MCP clone (has its own git repo; add as a submodule if needed)
mfp-mcp/
.aidesigner/*
!.aidesigner/.gitkeep
