# Auth — shared JWT secret. MUST be identical across ALL modules or auth fails.
# Copy the same value as vault/.env.
JWT_SECRET=

# Inbound security — any MCP client (Hermes, openclaw, Claude) must present this
# as a Bearer token or X-API-Key header. Generate: 32 random bytes, base64.
# REQUIRED whenever MCP_BIND is not localhost.
MCP_API_KEY=

# Bind address. Use http://0.0.0.0:5900 to accept agents from other machines (Meshnet).
MCP_BIND=http://localhost:5900

# Module endpoints — override when modules live on another machine.
# VAULT_API_URL=http://localhost:5000
# VITARA_API_URL=http://localhost:5100
# AASTHI_API_URL=http://localhost:5200
# SAN_API_URL=http://localhost:5300
# SUTRA_API_URL=http://localhost:5400
# NORTHSTAR_API_URL=http://localhost:5500
# KARMA_API_URL=http://localhost:5600
# NEXUS_API_URL=http://localhost:5700
