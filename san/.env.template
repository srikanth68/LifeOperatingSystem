# Auth — shared JWT secret. MUST be identical across ALL modules or auth fails.
# Generate once, copy the same value everywhere (see vault/.env).
JWT_SECRET=

# Telegram bot (reused from Nexus/sentinel watchers)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM — model-agnostic: swap provider/model here, no code changes needed.
# Supported providers: gemini | anthropic | ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Cross-module HTTP endpoints (San reads live context from ALL modules)
VAULT_API_URL=http://localhost:5000
VITARA_API_URL=http://localhost:5100
AASTHI_API_URL=http://localhost:5200
NORTHSTAR_API_URL=http://localhost:5500
SUTRA_API_URL=http://localhost:5400
KARMA_API_URL=http://localhost:5600
NEXUS_API_URL=http://localhost:5700

# Google Calendar (OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5300/api/calendar/callback

# Email triage — Gmail reuses the GOOGLE_CLIENT_ID/SECRET above (same OAuth app,
# additive gmail.readonly scope), just its own redirect URI/callback.
GOOGLE_EMAIL_REDIRECT_URI=http://localhost:5300/api/email/auth/google/callback
# Outlook/Office365 (Microsoft Graph OAuth) — Azure Portal → App registrations.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:5300/api/email/auth/microsoft/callback

# iPhone Context Push
DEVICE_API_KEY=changeme

# --- Local Gemma 4 via llama.cpp (OpenAI-compatible, on-device) ---
# LLM_PROVIDER=llamacpp
# LLM_MODEL=gemma-4
# LLM_BASE_URL=http://localhost:8080
# LLM_API_KEY=

# --- Voice: speech → text ---
# Gemma 4 is multimodal and transcribes audio on the same llama.cpp server used for
# chat, so STT needs no extra service — it works as soon as LLM_BASE_URL is set.
# Recordings are converted to 16 kHz mono WAV with ffmpeg first (bundled in the image).
# STT_PROVIDER=gemma            # "gemma" (default) or "whisper"
# STT_MODEL=gemma-4             # echoed to llama.cpp, which ignores it
#
# Fallback: run Whisper separately (docker compose --profile whisper up -d whisper)
# and set the URL below — that alone switches STT_PROVIDER's default to whisper.
# WHISPER_SERVICE_URL=http://localhost:9000   # STT: /v1/audio/transcriptions
# WHISPER_MODEL=whisper-1

# --- Voice: text → speech (self-hosted, OpenAI-compatible) — blank hides the speaker ---
# Gemma emits no audio, so this stays a separate service. Kokoro is the active engine.
# TTS_SERVICE_URL=http://localhost:8880       # TTS: /v1/audio/speech (Kokoro)
# TTS_VOICE=af_sky
# TTS_MODEL=tts-1
# PIPER_SERVICE_URL=http://localhost:8000     # legacy fallback (openedai-speech)
# PIPER_VOICE=alloy
# PIPER_MODEL=tts-1
