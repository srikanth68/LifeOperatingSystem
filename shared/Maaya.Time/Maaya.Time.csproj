<Project Sdk="Microsoft.NET.Sdk">

  <!-- No dependencies on purpose. Every module needs the clock, including the ones
       that must not grow an auth or web dependency just to know what day it is. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Reset() is a test seam and is not part of the surface other modules should reach for. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Maaya.Time.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
