# Vitara - Longevity Intelligence Platform
# Copy to .env and fill in values

OURA_CLIENT_ID=ZBYBB7266AGH4RSJ
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=http://localhost:5100/api/oura/callback

# Your chronological age for Bio Age delta calculation
VITARA_AGE=30

# Device key for the iOS MaayaCompanion app's Apple Health → Vitara ingest
# (POST /api/healthkit/ingest). Use the SAME value as San's DEVICE_API_KEY so
# one device key configured in the iOS app works for both San and Vitara.
DEVICE_API_KEY=changeme

# --- Nutrition (MyFitnessPal) ---
# The mfp sidecar's HTTP surface, reached over the compose network. Leave blank to
# disable the nutrition sync entirely; the worker then does nothing rather than
# logging a failure every day.
MFP_API_URL=http://mfp:8100
# Days of diary to re-check on each run. MFP entries are edited after the fact more
# often than Oura data is, so a few days of overlap is worth the extra requests.
NUTRITION_SYNC_DAYS=3
