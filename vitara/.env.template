# Vitara - Longevity Intelligence Platform
# Copy to .env and fill in values

# Oura Ring API — register your own app at https://cloud.ouraring.com/oauth/applications
OURA_CLIENT_ID=your_oura_client_id_here
OURA_CLIENT_SECRET=your_oura_client_secret_here
OURA_REDIRECT_URI=http://localhost:5100/api/oura/callback

# Your chronological age for Bio Age delta calculation
VITARA_AGE=30

# MyFitnessPal credentials (used to pull nutrition/meal logs)
MFP_USERNAME=your_mfp_username_here
MFP_PASSWORD=your_mfp_password_here

# USDA FoodData Central API key — free at https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=your_usda_api_key_here

# Auth (JWT) — must match JWT_SECRET in every other module's .env
JWT_SECRET=your-generated-jwt-secret-here
