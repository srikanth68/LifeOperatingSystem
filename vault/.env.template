# ─────────────────────────────────────────────────────────────────────────────
# Maaya / Vault — Secrets Template
# Copy this to .env and fill in your real credentials.
# .env is gitignored and will never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# Plaid environment: sandbox | development | production
# → Use "development" for real bank accounts (up to 100 linked items, free)
# → Use "production" for unlimited (requires Plaid approval)
PLAID_ENV=development

# Your Plaid Client ID — same across all environments
# Get it from: https://dashboard.plaid.com → Team Settings → Keys
PLAID_CLIENT_ID=your_client_id_here

# Your Plaid Secret for the environment chosen above
# Each environment (sandbox / development / production) has a different secret
PLAID_API_KEY=your_development_secret_here

# Vault.Worker daily sync time (HH:mm, 24h format)
SYNC_TIME=06:00

# ─── Auth (JWT) ───
# Run `dotnet script shared/auth-setup.csx` from the repo root to generate
# JWT_SECRET + AUTH_PASSWORD_HASH interactively — see SETUP.md.
JWT_SECRET=your-generated-jwt-secret-here
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=your-generated-bcrypt-hash-here
# Trusted-network PIN (Iron Man mode) — shown instead of full login on local/VPN
AUTH_PIN=1234
# Add your VPN subnet or specific IPs here (comma-separated CIDRs):
# Localhost + private ranges (10/172.16/192.168) are always trusted.
# AUTH_TRUSTED_NETWORKS=
