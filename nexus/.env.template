# Nexus — Trading Desk (read-only view onto Sentinel)
# Sentinel (Python, built separately) writes sentinel.db; Nexus.API only ever
# opens it in Mode=ReadOnly. Copy this to .env and fill in values.

# Path to the Sentinel SQLite database file (WAL mode).
# Adjust to wherever the Sentinel engine writes its db on this machine.
# Remote Sentinel HTTP API (takes priority over SENTINEL_DB_PATH when set).
# e.g. over a VPN tunnel: SENTINEL_API_URL=http://127.0.0.1:8787
# SENTINEL_API_URL=
# SENTINEL_API_PREFIX=
SENTINEL_DB_PATH=../sentinel/sentinel.db

# Auth (JWT) — must match JWT_SECRET in every other module's .env
JWT_SECRET=your-generated-jwt-secret-here
